{
  "name": "@sangjunsama/stm2",
  "version": "0.1.1",
  "description": "Collective Intelligence Memory for AI Agents — zero-token-cost persistent memory via hooks + CLAUDE.md",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stm2": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist/",
    "src/hooks/",
    "package.json"
  ],
  "keywords": [
