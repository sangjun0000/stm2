    "memory",
    "mcp",
    "claude",
    "hooks",
    "collective-intelligence",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
